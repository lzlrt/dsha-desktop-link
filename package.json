{
  "name": "@local/dsha-desktop-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "侧栏加一个按钮：一键打开「桌面版 DSH」。手机上由 DSHA 交给系统浏览器，电脑上新标签页打开。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
