{
  "name": "dsh-desktop-link",
  "version": "1.0.0",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "assets"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "author": "lzlrt",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsha",
    "remote",
    "sidebar",
    "mobile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzlrt/dsha-desktop-link.git"
  },
  "homepage": "https://github.com/lzlrt/dsha-desktop-link#readme",
  "bugs": {
    "url": "https://github.com/lzlrt/dsha-desktop-link/issues"
  },
  "description": "DSH sidebar button: open the desktop DSH Web GUI from DSHA on your phone, in one tap.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}